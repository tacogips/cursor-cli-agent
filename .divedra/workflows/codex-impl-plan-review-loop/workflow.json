{
  "workflowId": "codex-impl-plan-review-loop",
  "description": "Codex implementation workflow: Step 1 uses gpt-5.4 to inspect the impl plan, implement, update the plan, self-review in the same implementation session, and hand changes through output.input; Step 2 uses gpt-5.5 to review and routes high/mid feedback back to Step 1.",
  "defaults": {
    "maxLoopIterations": 3,
    "nodeTimeoutMs": 120000
  },
  "prompts": {
    "divedraPromptTemplate": "Coordinate {{workflowId}}. Run Step 1 first, then run Step 1 self-review in the same implementation session before Step 2 reviews the handoff. If Step 2 reports high or mid severity findings, route the feedback back to Step 1 for revision. Finish only when Step 2 reports no high or mid findings.",
    "workerSystemPromptTemplate": "Return concise business JSON only. Keep file paths and verification commands explicit."
  },
  "managerStepId": "divedra-manager",
  "entryStepId": "divedra-manager",
  "nodes": [
    {
      "id": "divedra-manager",
      "nodeFile": "nodes/node-divedra-manager.json"
    },
    {
      "id": "step1-implement",
      "nodeFile": "nodes/node-step1-implement.json"
    },
    {
      "id": "step2-review",
      "nodeFile": "nodes/node-step2-review.json"
    },
    {
      "id": "workflow-output",
      "nodeFile": "nodes/node-workflow-output.json"
    }
  ],
  "steps": [
    {
      "id": "divedra-manager",
      "nodeId": "divedra-manager",
      "role": "manager",
      "transitions": [
        {
          "toStepId": "step1-implement"
        }
      ]
    },
    {
      "id": "step1-implement",
      "nodeId": "step1-implement",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "step1-self-review"
        }
      ]
    },
    {
      "id": "step1-self-review",
      "nodeId": "step1-implement",
      "role": "worker",
      "promptVariant": "self-review",
      "sessionPolicy": {
        "mode": "reuse",
        "inheritFromStepId": "step1-implement"
      },
      "transitions": [
        {
          "toStepId": "step2-review"
        }
      ]
    },
    {
      "id": "step2-review",
      "nodeId": "step2-review",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "step1-implement",
          "label": "needs_revision"
        },
        {
          "toStepId": "workflow-output",
          "label": "!(needs_revision)"
        }
      ]
    },
    {
      "id": "workflow-output",
      "nodeId": "workflow-output",
      "role": "worker"
    }
  ]
}
