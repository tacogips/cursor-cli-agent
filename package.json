{
  "name": "curort-cli-agent",
  "version": "0.1.0",
  "description": "curort-cli-agent",
  "type": "module",
  "bin": {
    "curort-cli-agent": "src/main.ts"
  },
  "main": "dist/main.js",
  "module": "dist/main.js",
  "types": "dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js",
      "default": "./dist/main.js"
    }
  },
  "scripts": {
    "dev": "bun run --watch src/main.ts",
    "build": "bun build src/main.ts --outdir dist --target bun",
    "start": "bun run src/main.ts",
    "test": "scripts/run-src-tests.sh",
    "test:watch": "scripts/run-src-tests.sh --watch",
    "typecheck": "tsc --noEmit",
    "lint": "bun run typecheck",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "clean": "rm -rf dist"
  },
  "homepage": "https://github.com/tacogips/cursor-cli-agent",
  "repository": {
    "type": "git",
    "url": "https://github.com/tacogips/cursor-cli-agent.git"
  },

  "license": "MIT",
  "trustedDependencies": [],
  "devDependencies": {
    "@types/bun": "1.1.14",
    "typescript": "5.7.2",
    "prettier": "3.4.2"
  }
}
